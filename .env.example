# Copy to .env and adjust.

# NODE_ENV=development
LOG_LEVEL=info

# SQLite file. Relative paths resolve from the repo root.
DATABASE_URL=file:./data/dev.db
REDIS_URL=redis://localhost:6379

# Encrypts the stored OAuth tokens. Required. Generate with: openssl rand -base64 32
# Losing it means reconnecting every account; leaking it (with the DB) leaks the tokens.
TOKEN_ENCRYPTION_KEY=

# Gemini only: Gemini CLI's public OAuth client. Copy OAUTH_CLIENT_ID and OAUTH_CLIENT_SECRET from
# https://github.com/google-gemini/gemini-cli/blob/main/packages/core/src/code_assist/oauth2.ts
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=

# Claude only: OAuth scopes requested at sign-in. Default: "user:profile user:inference".
# CLAUDE_OAUTH_SCOPES=

# How often every account is collected (server and worker must agree).
COLLECT_INTERVAL_MINUTES=5

# Server
APP_NAME=Usage
PORT=3000
# Loopback by default. Put a TLS reverse proxy in front before exposing it.
# HOST=127.0.0.1
# HTTP Basic auth for the whole UI and API. Optional in development, required in production.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# morgan format. Defaults to "dev", or "combined" in production.
# HTTP_LOG_FORMAT=dev
# Number of proxies in front of the app (set to 1 behind nginx/Caddy).
TRUST_PROXY=0
# Where the built web assets live. Defaults to <repo>/apps/web/dist.
# WEB_DIST_DIR=

# pm2: number of server instances (cluster mode)
WEB_CONCURRENCY=1

# Worker
WORKER_CONCURRENCY=5
